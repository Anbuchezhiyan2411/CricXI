# CricXI Environment Configuration
APP_NAME=CricXI
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./cricxi.db

# Dataset Configuration (Optional - defaults to bundled app/data/master_players.csv)
DATASET_PATH=app/data/master_players.csv

# Logging
LOG_LEVEL=INFO

