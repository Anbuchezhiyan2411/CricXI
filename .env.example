# CricXI Environment Configuration
APP_NAME=CricXI
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./cricxi.db

# Dataset Configuration
# Relative to repository root or backend working directory
DATASET_PATH=dataset/output/master_players.csv

# Logging
LOG_LEVEL=INFO

